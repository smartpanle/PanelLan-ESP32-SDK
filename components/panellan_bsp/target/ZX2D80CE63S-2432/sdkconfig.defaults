# Board: ZX2D80CE63S-2432
CONFIG_ZX2D80CE63S=y
CONFIG_IDF_TARGET="esp32c61"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set

CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM=y

# Panel geometry (menuconfig → PanelLan config → LCD)
CONFIG_PANELLAN_LCD_H_RES=240
CONFIG_PANELLAN_LCD_V_RES=320

# Board input (menuconfig → PanelLan config → Hardware)
# CONFIG_PANELLAN_BOARD_USE_ENCODER is not set

# Default LCD/Touch (overridable in menuconfig → PanelLan config → LCD / Touch)
CONFIG_PANELLAN_LCD_ENABLE_SPI_WITH_PSRAM=y
CONFIG_PANELLAN_LCD_PANEL_ST7789=y
CONFIG_PANELLAN_TOUCH_FT5X06=y

