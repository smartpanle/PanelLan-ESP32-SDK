# Board: ZX2D10GE01R-V-4848
CONFIG_ZX2D10GE01R=y
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

CONFIG_ESP_LVGL_ADAPTER_ENABLE_KNOB=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_BUTTON=y

# Panel geometry (menuconfig → PanelLan config → LCD)
CONFIG_PANELLAN_LCD_H_RES=480
CONFIG_PANELLAN_LCD_V_RES=480

# Board input (menuconfig → PanelLan config → Hardware)
CONFIG_PANELLAN_BOARD_USE_ENCODER=y

# Default LCD/Touch (overridable in menuconfig → PanelLan config → LCD / Touch)
CONFIG_PANELLAN_LCD_ENABLE_RGB=y
CONFIG_PANELLAN_LCD_PANEL_RGB_ONLY=y

